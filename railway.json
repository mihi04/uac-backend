{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
      "builder": "DOCKERFILE",
      "dockerfilePath": "Dockerfile"
    },
    "deploy": {
      "runtime": "V2",
      "numReplicas": 1,
      "startCommand": "gunicorn freight_project.wsgi:application --bind 0.0.0.0:$PORT --workers 4 --timeout 120 --access-logfile -",
      "sleepApplication": false,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10
    }
  }