# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Django
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Local dev without PostgreSQL: set True to use SQLite (db.sqlite3). Omit or False for Docker/Postgres.
USE_SQLITE=False

# Database (PostgreSQL)
DB_NAME=freight_db
DB_USER=postgres
DB_PASSWORD=rhOlKbAlrMOVrnNsSUNMPsfKrXBoQQHY
DB_HOST=postgres.railway.internal
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourfreightcompany.com

# Company Info
COMPANY_NAME=Smart Freight Pvt Ltd
COMPANY_GST=27AABCU9603R1ZX
COMPANY_PAN=AABCU9603R

# File Storage: 'local' or 's3'
FILE_STORAGE_BACKEND=local

# AWS S3 (only needed if FILE_STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=freight-docs
AWS_S3_REGION_NAME=ap-south-1

# Redis (for Celery task queue — optional)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
